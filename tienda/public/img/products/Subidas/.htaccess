# Las imágenes subidas desde el panel nunca se ejecutan ni se listan.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py
<FilesMatch "\.(?i:jpe?g|png|webp)$">
    Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:jpe?g|png|webp)$).*$">
    Require all denied
</FilesMatch>
